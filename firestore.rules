rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User profile and preferences
    match /users/{userId} {
      allow get, list: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidId(userId);
      allow delete: if isOwner(userId);

      // Workout days
      match /days/{dayId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(dayId) && request.resource.data.userId == userId;
        allow delete: if isOwner(userId);
      }

      // Workout sessions log
      match /sessions/{sessionId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(sessionId) && request.resource.data.userId == userId;
        allow delete: if isOwner(userId);
      }

      // Weight entries log
      match /weight_entries/{entryId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(entryId) && request.resource.data.userId == userId;
        allow delete: if isOwner(userId);
      }
    }
  }
}
